---
const { title, description, techs = [], href, source } = Astro.props
---
<li class="group relative flex items-center justify-between gap-4 -mx-3 px-3 py-4 rounded-lg border-b border-stone-200/70 dark:border-stone-800/70 last:border-b-0 hover:border-transparent hover:bg-linear-to-r hover:from-primary/[0.06] hover:to-accent/[0.08] transition-colors">
	<div class="min-w-0">
		<a href={href} target="_blank" rel="noopener" class="flex items-center gap-2 text-stone-900 dark:text-stone-100 font-medium after:absolute after:inset-0">
			<span class="group-hover:text-primary dark:group-hover:text-accent transition-colors">{title}</span>
			<span aria-hidden="true" class="text-stone-400 group-hover:text-accent transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
		</a>
		{description && <p class="text-sm text-stone-500 dark:text-stone-400 mt-1">{description}</p>}
		{source && (
			<a href={source} target="_blank" rel="noopener" class="relative z-10 text-xs text-stone-500 hover:text-primary dark:hover:text-accent transition-colors">
				source code
			</a>
		)}
	</div>
	<div class="flex gap-1 shrink-0">
		{techs.map((tech: { src: string; alt: string }) => (
			<span class="p-1.5 rounded-md bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 group-hover:border-accent/40 transition-colors" title={tech.alt.replace(" logo", "")}>
				<img class="h-4 w-4" height="16" width="16" src={tech.src} alt={tech.alt} />
			</span>
		))}
	</div>
</li>
