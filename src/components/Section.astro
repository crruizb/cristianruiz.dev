---
const { title, index } = Astro.props
---
<section class="reveal grid gap-6 md:grid-cols-[9rem_1fr] md:gap-10 py-12 border-t border-stone-200 dark:border-stone-800">
	<h3 class="flex items-baseline gap-2 text-xs uppercase tracking-[0.2em] text-stone-500 md:pt-1">
		{index && <span class="font-semibold bg-linear-to-r from-primary to-accent bg-clip-text text-transparent">{index}</span>}
		{title}
	</h3>
	<div>
		<slot />
	</div>
</section>
