---
import Layout from '@/layouts/Layout.astro';
---
<Layout>
	<main class="flex flex-col justify-center py-24">
		<p class="text-xs uppercase tracking-[0.2em] text-stone-500 mb-6">Error 404</p>
		<h1 class="text-5xl sm:text-6xl font-bold tracking-tight text-stone-900 dark:text-stone-50">
			Page not found<span class="bg-linear-to-r from-primary to-accent bg-clip-text text-transparent">.</span>
		</h1>
		<p class="mt-6 text-lg text-stone-600 dark:text-stone-400">The requested page does not exist.</p>
		<a href="/" class="group mt-10 inline-flex items-center gap-2 text-sm font-medium text-stone-900 dark:text-stone-100">
			<span class="transition-transform group-hover:-translate-x-1">←</span> Back to home
		</a>
	</main>
</Layout>
